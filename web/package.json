{
  "name": "cti-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local, read-only dashboard over `cti export` JSON (served by `cti serve`).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check": "node --test scripts/check.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
